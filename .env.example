# Copy to .env for Docker Compose. Local Python reads OS environment variables.
MYSQL_ROOT_PASSWORD=change-this-local-root-password
MYSQL_PASSWORD=change-this-local-app-password
# Local Python MySQL connection (set these in your shell when using --backend mysql)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=hospital_demo
MYSQL_USER=hospital
# Optional OpenAI-compatible chat completions provider. Never commit real keys.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
